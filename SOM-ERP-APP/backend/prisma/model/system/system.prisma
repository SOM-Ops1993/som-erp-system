// ─── SYSTEM — USERS & AUDIT ───────────────────────────────────────────────────
//
// Models in this file:
//   User      — App users with role-based access (auth via password or PIN)
//   AuditLog  — Append-only audit trail for all data mutations
//
// ─────────────────────────────────────────────────────────────────────────────

model User {
  userId       String    @id @default(dbgenerated("gen_random_uuid()")) @map("user_id") @db.Uuid
  username     String    @unique @db.VarChar(100)
  email        String?   @unique @db.VarChar(200)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  fullName     String    @map("full_name") @db.VarChar(200)
  phone        String?   @db.VarChar(20)
  pinHash      String?   @map("pin_hash") @db.VarChar(255)
  role         String    @db.VarChar(50)
  // gate_staff | store_person | store_manager | planner | planning_manager
  // plant_supervisor | qc_person | sales_team | admin
  isActive     Boolean        @default(true) @map("is_active")
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  approvedBoms  ErpBomHeader[]
  notifications ErpNotification[]

  @@map("users")
}

model AuditLog {
  id         BigInt    @id @default(autoincrement())
  userId     String?   @map("user_id") @db.Uuid
  username   String?   @db.VarChar(100)
  action     String    @db.VarChar(50)
  tableName  String?   @map("table_name") @db.VarChar(100)
  recordId   String?   @map("record_id") @db.VarChar(200)
  oldValue   Json?     @map("old_value")
  newValue   Json?     @map("new_value")
  ipAddress  String?   @map("ip_address") @db.VarChar(50)
  notes      String?
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  @@map("audit_log")
}
