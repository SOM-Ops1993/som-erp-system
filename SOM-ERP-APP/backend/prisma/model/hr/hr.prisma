// ─── HR & ACCESS CONTROL ─────────────────────────────────────────────────────
//
// Models in this file:
//   CompanyMaster   — Legal entities / companies operating under the ERP
//                     (DVS, SOM, AL-IPL, AL-PTE)
//   EmployeeMaster  — Employee records with role-based access assignment
//   RolePermission  — Page-level permission map per role (role → page path)
//
// ─────────────────────────────────────────────────────────────────────────────

model CompanyMaster {
  id        String   @id @default(cuid())
  code      String   @unique                 // DVS | SOM | AL-IPL | AL-PTE
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("company_master")
}

model EmployeeMaster {
  id        String   @id @default(cuid())
  empCode   String   @unique @map("emp_code")
  name      String
  email     String?  @unique
  phone     String?
  role      String
  // ADMIN | SALES | PRODUCTION | QC | DISPATCH | PLANNING | ACCOUNTS
  section   String?
  // NANO | BOTANICAL | LIQUID | POWDER | GRANULES (applicable to PRODUCTION role)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("employee_master")
}

model RolePermission {
  id        String @id @default(cuid())
  role      String
  pagePath  String @map("page_path")
  pageLabel String @map("page_label")

  @@unique([role, pagePath])
  @@map("role_permission")
}
