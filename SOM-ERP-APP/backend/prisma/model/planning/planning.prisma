// ─── PRODUCTION PLANNING ──────────────────────────────────────────────────────
//
// Models in this file:
//   ProductionPlan  — Planning record (PP-YYYY-NNNN) generated by the planning engine
//                     from open Sales Order items; drives indent creation
//   PlanSequence    — Auto-increment sequence for PP numbers (per year)
//   PlannerLog      — Audit log of every planner engine run (manual or scheduled)
//   BomSend         — BOM send request from planner → store to prepare materials
//                     (one record per BOM type: FORMULATION or PACKING)
//   SheetSyncLog    — Audit log of every Google Sheet sync import
//
// ─────────────────────────────────────────────────────────────────────────────

// ─── PRODUCTION PLANNING ENGINE ──────────────────────────────────────────────

model ProductionPlan {
  id               String   @id @default(cuid())
  planId           String   @unique @map("plan_id")       // PP-2026-0001
  salesOrderId     String?  @map("sales_order_id")
  salesOrderItemId String?  @map("sales_order_item_id")
  diNo             String   @map("di_no")
  customerName     String?  @map("customer_name")
  sectionType      String   @map("section_type")          // NANO|BOTANICAL|LIQUID|POWDER|GRANULES
  plannedDate      DateTime @map("planned_date")
  shift            String?                                 // A|G|B|C
  batchIncharge    String?  @map("batch_incharge")
  noOfCycles       Int?     @map("no_of_cycles")
  cycleBatchSize   Float?   @map("cycle_batch_size")
  equipment        String?
  location         String?
  productCode      String?  @map("product_code")
  productName      String   @map("product_name")
  batchCode        String?  @map("batch_code")
  totalQty         Float    @map("total_qty")
  uom              String   @default("KG")
  carrier          String?
  specs            String?
  process          String?
  stageInfo        String?  @map("stage_info")            // BOTANICAL: days/hours

  // Packing details
  unitPackQty      Float?   @map("unit_pack_qty")
  noOfUnits        Int?     @map("no_of_units")
  pp1              String?
  pp2              String?
  sp1              String?
  noOfSp           Int?     @map("no_of_sp")
  labels           String?
  packingSpec      String?  @map("packing_spec")
  perDayCompletion Int?     @map("per_day_completion")
  femaleWorkers    Int?     @map("female_workers")
  maleWorkers      Int?     @map("male_workers")

  // Status & automated checks
  status           String   @default("DRAFT")             // DRAFT|REVIEWED|IN_PROGRESS|COMPLETED|CANCELLED
  rmCheckStatus    String?  @map("rm_check_status")       // GREEN|AMBER|RED
  eqpCheckStatus   String?  @map("eqp_check_status")      // AVAILABLE|BUSY|UNKNOWN
  rmCheckDetails   Json?    @map("rm_check_details")      // [{rmCode, required, available, status}]
  autoGenerated    Boolean  @default(false) @map("auto_generated")
  remarks          String?
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("production_plan")
}

model PlanSequence {
  year Int @id
  seq  Int @default(0)

  @@map("plan_sequence")
}

model PlannerLog {
  id              String   @id @default(cuid())
  runAt           DateTime @default(now()) @map("run_at")
  trigger         String                                   // MANUAL|SCHEDULED
  plansCreated    Int      @default(0) @map("plans_created")
  ordersProcessed Int      @default(0) @map("orders_processed")
  errors          String?

  @@map("planner_log")
}

// ─── BOM SEND REQUESTS (planner → store) ─────────────────────────────────────
// Created by planner when they want the store to prepare materials for production.
// Formulation BOM and Packing BOM are sent as separate records.

model BomSend {
  id          String    @id @default(cuid())
  sendId      String    @unique @map("send_id")         // e.g. BOM-2605-001
  indentId    String?   @map("indent_id")               // linked indent (if RM BOM)
  planId      String    @map("plan_id")
  productCode String    @map("product_code")
  productName String    @map("product_name")
  batchNo     String    @map("batch_no")
  diNo        String    @map("di_no")
  sectionType String?   @map("section_type")
  bomType     String    @map("bom_type")                // 'FORMULATION' | 'PACKING'
  totalQty    Float     @map("total_qty")
  uom         String    @default("KG")
  status      String    @default("PENDING")             // PENDING | PICKED | ISSUED | CANCELLED
  remarks     String?
  sentBy      String?   @map("sent_by")
  sentAt      DateTime  @default(now()) @map("sent_at")
  pickedAt    DateTime? @map("picked_at")
  issuedAt    DateTime? @map("issued_at")

  @@map("bom_send")
}

// ─── GOOGLE SHEET SYNC ───────────────────────────────────────────────────────

model SheetSyncLog {
  id        String   @id @default(cuid())
  trigger   String   @default("WEBHOOK")   // WEBHOOK | MANUAL | SCHEDULED
  rowsIn    Int      @default(0) @map("rows_in")
  imported  Int      @default(0)
  skipped   Int      @default(0)
  errors    Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("sheet_sync_log")
}
