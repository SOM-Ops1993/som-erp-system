{
  "name": "som-erp-backend",
  "version": "2.0.0",
  "description": "SOM ERP Backend",
  "main": "src/server.js",
  "type": "module",
  "prisma": {
    "schema": "./prisma/model"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "server": "nodemon src/server.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push --accept-data-loss",
    "db:post-migrate": "psql %DATABASE_URL% -f prisma/migrations/001_setup.sql"
  },
  "dependencies": {
    "@prisma/client": "^5.14.0",
    "cors": "^2.8.6",
    "dayjs": "^1.11.11",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "multer": "^2.1.1",
    "nodemon": "^3.1.14",
    "pdfkit": "^0.15.0",
    "qrcode": "^1.5.4",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "pino-pretty": "^13.1.3",
    "prisma": "^5.14.0"
  }
}
